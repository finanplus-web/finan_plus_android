    { "match": "org.robolectric:*", "license": "MIT", "scopes": ["test"] },
    { "match": "io.github.takahirom.roborazzi:*", "license": "Apache-2.0", "scopes": ["test"] },
    { "match": "com.dropbox.differ:*", "license": "Apache-2.0", "scopes": ["test"] },
    { "match": "com.almworks.sqlite4java:sqlite4java", "license": "Apache-2.0", "scopes": ["test"] },
