    { "match": "com.google.j2objc:j2objc-annotations", "license": "Apache-2.0", "scopes": ["test"] },
    { "match": "com.google.testparameterinjector:test-parameter-injector", "license": "Apache-2.0", "scopes": ["test"] },
    { "match": "com.squareup:javawriter", "license": "Apache-2.0", "scopes": ["test"] },
    { "match": "javax.inject:javax.inject", "license": "Apache-2.0", "scopes": ["test"] },
    { "match": "javax.annotation:javax.annotation-api", "license": "CDDL-1.1 OR GPL-2.0-only WITH Classpath-exception-2.0", "scopes": ["test"],
      "license_evidence": "O SBOM não traz a licença deste componente (o POM do projeto declara 'CDDL + GPLv2 with classpath exception'); o projeto (https://github.com/javaee/javax.annotation, arquivo LICENSE) é CDDL 1.1 ou GPL 2 com Classpath Exception. Só em testes (Robolectric), não distribuído." }
  ]
