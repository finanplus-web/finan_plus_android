    { "match": "androidx.compose.material:material-android", "license": "Apache-2.0", "scopes": ["debug", "test"] },
    { "match": "androidx.*:*", "license": "Apache-2.0", "scopes": ["release", "debug", "test"], "notice": "AndroidX (Jetpack)" },

    { "match": "com.tom-roush:pdfbox-android", "license": "Apache-2.0", "scopes": ["release", "debug", "test"], "notice": "PdfBox-Android" },
    { "match": "org.bouncycastle:*-jdk15to18", "license": "MIT", "scopes": ["release", "debug", "test"], "notice": "Bouncy Castle" },
    { "match": "org.bouncycastle:bcprov-jdk18on", "license": "MIT", "scopes": ["test"] },

